# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Brainstorming mockups
.superpowers/

# Isolated agent development worktrees
/.worktrees/

# dependencies
/node_modules
/convex-template/node_modules
/webnegosyo-app/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Cloudinary backup binary blobs (keep scripts + manifest, exclude the images)
/cloudinary-backup/files/

# Local agent tool configuration (per-machine, not project source)
/.codex/
/.grok/

# Scratch inputs kept beside the repo: a supplier spreadsheet, a video subtitle
# file, a loading clip and an empty handoff tarball. Not referenced by any build.
/IMM_Items_*.xlsx
/*.srt
/mascot-loading.mp4
/seacook-qa-grok-code-handoff.tar.gz

# Image backup binary blobs (keep scripts + URL list, exclude the images)
/image-backup/files/
/image-backup/urls.json
/image-backup/manifest.json
/image-backup/failures.json
/image-backup/restore-result.json
/image-backup/relink.sql

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin

# Database backups (may contain secrets)
/backup/

# Desktop binary too large for GitHub (100MB limit) — host .dmg on CDN/Release
public/downloads/*.dmg

# Local Claude Code agent config / session state (machine-local, not product code)
/.claude/

# Apple auth keys (never commit)
*.p8

# Playwright
/test-results/
/playwright-report/
/blob-report/

# Design-tooling scratch (screenshots + critiques), regenerated on demand
/.impeccable/
