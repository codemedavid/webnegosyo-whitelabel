nd-color: var(--trk-hero-track);"><div class="h-full rounded-full" style="background-color: var(--trk-hero-bar);"></div></div><div data-part="step" data-done="" class="h-2 flex-1 overflow-hidden rounded-full" style="background-color: var(--trk-hero-track);"><div class="h-full rounded-full" style="background-color: var(--trk-hero-bar);"></div></div><div data-part="step" data-on="" class="h-2 flex-1 overflow-hidden rounded-full" style="background-color: var(--trk-hero-track);"><div class="h-full rounded-full" style="background-color: var(--trk-hero-bar);"></div></div><div data-part="step" class="h-2 flex-1 overflow-hidden rounded-full" style="background-color: var(--trk-hero-track);"><div class="h-full rounded-full" style="background-color: var(--trk-hero-bar);"></div></div><div data-part="step" class="h-2 flex-1 overflow-hidden rounded-full" style="background-color: var(--trk-hero-track);"><div class="h-full rounded-full" style="background-color: var(--trk-hero-bar);"></div></div></div><div data-part="card" class="relative mt-4 px-4 py-3 backdrop-blur" style="border-radius: var(--trk-radius-inner); background-color: var(--trk-hero-chip-soft);"><p data-part="text" class="text-lg font-bold leading-tight">Ready by 12:42 PM</p><p data-part="muted" class="text-sm opacity-90">About 12 minutes</p></div><div data-part="muted" class="relative mt-4 flex flex-wrap items-center gap-2 text-xs opacity-85"><span>Placed 12:24 PM</span><span aria-hidden="true">·</span><span>Delivery</span></div></section><div class="space-y-1.5" data-branding-scope="tracking/ring"><button type="button" data-part="button" class="flex h-12 w-full items-center justify-center gap-2 border-2 text-sm font-semibold transition-colors disabled:cursor-default" style="border-radius: var(--trk-radius-pill); border-color: var(--trk-ring-border); background-color: var(--trk-ring-bg); color: var(--trk-ring-text);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell h-4 w-4" data-part="icon" aria-hidden="true"><path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg>Ring me when my order is ready</button></div><p data-testid="loyalty-notice">notice</p><div data-testid="loyalty-slot">card</div><section aria-label="Order progress" data-branding-scope="tracking/timeline" data-part="card" class="border p-5 shadow-sm" style="border-radius: var(--trk-radius); background-color: var(--trk-card); border-color: var(--trk-card-border);"><h2 data-part="title" class="mb-4 text-xs font-semibold uppercase tracking-[0.18em]" style="color: var(--trk-text-muted);">Progress</h2><ol class="relative"><li class="flex gap-4"><div class="flex flex-col items-center"><div data-part="step" data-done="" class="flex h-10 w-10 items-center justify-center rounded-full border-2 transition-all duration-500 " style="background-color: var(--trk-step-done); border-color: var(--trk-step-done); color: var(--trk-on-step-done);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-5 w-5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></div><div class="w-0.5 flex-1 min-h-8 transition-colors duration-500" style="background-color: var(--trk-step-done);"></div></div><div class="pb-6 pt-2 "><p class="text-sm font-semibold" style="color: var(--trk-step-done);">Order received</p><p data-part="muted" class="mt-0.5 text-xs" style="color: var(--trk-text-muted);">Waiting for the store to confirm.</p></div></li><li class="flex gap-4"><div class="flex flex-col items-center"><div data-part="step" data-done="" class="flex h-10 w-10 items-center justify-center rounded-full border-2 transition-all duration-500 " style="background-color: var(--trk-step-done); border-color: var(--trk-step-done); color: var(--trk-on-step-done);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check h-5 w-5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg></div><div class="w-0.5 flex-1 min-h-8 transition-colors duration-500" style="background-color: var(--trk-step-done);"></div></div><div class="pb-6 pt-2 "><p class="text-sm font-semibold" style="color: var(--trk-step-done);">Confirmed</p><p data-part="muted" class="mt-0.5 text-xs" style="color: var(--trk-text-muted);">The store accepted your order.</p></div></li><li class="flex gap-4" aria-current="step"><div class="flex flex-col items-center"><div data-part="step" data-on="" class="flex h-10 w-10 items-center justify-center rounded-full border-2 transition-all duration-500 animate-pulse motion-reduce:animate-none" style="background-color: var(--trk-step-current); border-color: var(--trk-step-current); color: var(--trk-on-step-current); box-shadow: 0 0 0 6px var(--trk-step-current-soft);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chef-hat h-5 w-5" aria-hidden="true"><path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"></path><path d="M6 17h12"></path></svg></div><div class="w-0.5 flex-1 min-h-8 transition-colors duration-500" style="background-color: var(--trk-step-upcoming);"></div></div><div class="pb-6 pt-2 "><p class="text-sm font-semibold" style="color: var(--trk-step-current);">Preparing</p><p data-part="muted" class="mt-0.5 text-xs" style="color: var(--trk-text-muted);">Your food is being prepared right now.</p></div></li><li class="flex gap-4"><div class="flex flex-col items-center"><div data-part="step" class="flex h-10 w-10 items-center justify-center rounded-full border-2 transition-all duration-500 " style="background-color: transparent; border-color: var(--trk-step-upcoming); color: var(--trk-text-faint);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package h-5 w-5" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><path d="m7.5 4.27 9 5.15"></path></svg></div><div class="w-0.5 flex-1 min-h-8 transition-colors duration-500" style="background-color: var(--trk-step-upcoming);"></div></div><div class="pb-6 pt-2 opacity-50"><p class="text-sm font-semibold" style="color: var(--trk-text-muted);">Ready</p><p data-part="muted" class="mt-0.5 text-xs" style="color: var(--trk-text-muted);">Ready for pickup or on its way.</p></div></li><li class="flex gap-4"><div class="flex flex-col items-center"><div data-part="step" class="flex h-10 w-10 items-center justify-center rounded-full border-2 transition-all duration-500 " style="background-color: transparent; border-color: var(--trk-step-upcoming); color: var(--trk-text-faint);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-truck h-5 w-5" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path><path d="M15 18H9"></path><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path><circle cx="17" cy="18" r="2"></circle><circle cx="7" cy="18" r="2"></circle></svg></div></div><div class="pb-6 pt-2 opacity-50"><p class="text-sm font-semibold" style="color: var(--trk-text-muted);">Completed</p><p data-part="muted" class="mt-0.5 text-xs" style="color: var(--trk-text-muted);">Order complete. Thanks for ordering!</p></div></li></ol></section><section aria-label="Order summary" data-branding-scope="tracking/summary" data-part="card" class="border p-5 shadow-sm" style="border-radius: var(--trk-radius); background-color: var(--trk-card); border-color: var(--trk-card-border);"><h2 data-part="title" class="mb-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em]" style="color: var(--trk-text-muted);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-receipt h-4 w-4" aria-hidden="true"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"></path><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 17.5v-11"></path></svg>Your order</h2><ul class="divide-y" style="border-color: var(--trk-card-border);"><li class="flex justify-between gap-3 py-2.5 text-sm first:pt-0"><div class="min-w-0 flex-1"><p data-part="text" class="font-medium" style="color: var(--trk-text);"><span data-part="badge" class="mr-2 inline-flex h-6 min-w-6 items-center justify-center rounded-md px-1.5 text-xs font-bold" style="background-color: var(--trk-qty-bg); color: var(--trk-qty-text);">2×</span>Chicken Inasal<span data-part="muted" class="text-xs" style="color: var(--trk-text-muted);"> (Paa)</span></p><p data-part="muted" class="mt-0.5 pl-8 text-xs" style="color: var(--trk-text-faint);">+ Extra rice</p></div><span data-part="price" class="shrink-0 font-medium" style="color: var(--trk-text);">₱330.00</span></li><li class="flex justify-between gap-3 py-2.5 text-sm first:pt-0"><div class="min-w-0 flex-1"><p data-part="text" class="font-medium" style="color: var(--trk-text);"><span data-part="badge" class="mr-2 inline-flex h-6 min-w-6 items-center justify-center rounded-md px-1.5 text-xs font-bold" style="background-color: var(--trk-qty-bg); color: var(--trk-qty-text);">1×</span>Iced Calamansi</p></div><span data-part="price" class="shrink-0 font-medium" style="color: var(--trk-text);">₱65.00</span></li></ul><div data-part="divider" class="mt-3 space-y-1.5 border-t pt-3 text-sm" style="border-color: var(--trk-card-border);"><div data-part="muted" class="flex justify-between" style="color: var(--trk-text-muted);"><span>Delivery fee</span><span>₱49.00</span></div><div class="flex items-baseline justify-between pt-1"><span data-part="total" class="text-base font-bold" style="color: var(--trk-text);">Total</span><span data-part="total" class="text-xl font-extrabold" style="color: var(--trk-total);">₱444.00</span></div></div></section><div class="pb-8 pt-2"><button type="button" data-part="button-alt" class="flex h-12 w-full items-center justify-center gap-2 rounded-full text-sm font-semibold transition-opacity hover:opacity-80" style="color: var(--trk-text-muted);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left h-5 w-5" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>Menu please</button></div></div></main></div>"`;

