exports[`CheckoutConfirmation — standard thank-you page is unchanged minimal order: no fees, fields or payment 1`] = `"<div class="min-h-screen bg-[var(--co-bg)] text-[color:var(--co-text)]" style="--co-bg: #ffffff; --co-card: #ffffff; --co-summary: #ffffff; --co-text: #111111; --co-muted: #6b7280; --co-border: #e5e7eb; --co-subtle: rgba(17, 17, 17, 0.05); --co-subtle-strong: rgba(17, 17, 17, 0.09); --co-accent: #111111; --co-accent-text: #ffffff; --co-accent-soft: rgba(17, 17, 17, 0.08); --co-accent-softer: rgba(17, 17, 17, 0.04); --co-accent-border: rgba(17, 17, 17, 0.45); --co-button: #111111; --co-success: #10b981; --co-success-soft: rgba(16, 185, 129, 0.12); --co-warning: #f59e0b; --co-warning-soft: rgba(245, 158, 11, 0.12); --co-warning-border: rgba(245, 158, 11, 0.45); --co-error: #ef4444; --co-error-soft: rgba(239, 68, 68, 0.12);"><main class="container mx-auto px-4 py-8"><div class="mx-auto max-w-2xl space-y-6"><div class="text-center py-8"><div data-part="icon" class="inline-flex items-center justify-center w-24 h-24 rounded-full mb-5 bg-[var(--co-success-soft)]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check h-14 w-14 text-[color:var(--co-success)] animate-[scale-in_0.4s_ease-out]" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg></div><h1 data-part="title" class="text-3xl font-bold text-[color:var(--co-text)] mb-2">Order Placed!</h1><p data-part="subtitle" class="text-[color:var(--co-muted)] text-lg">Your order has been sent to Lola’s Kitchen</p></div><div data-branding-scope="checkout/card" data-part="card" class="rounded-2xl bg-[var(--co-card)] p-6 shadow-sm border border-[color:var(--co-border)]"><h2 data-part="title" class="text-lg font-bold text-[color:var(--co-text)] mb-1">Order Summary</h2><div class="space-y-3"><div><div class="flex ju