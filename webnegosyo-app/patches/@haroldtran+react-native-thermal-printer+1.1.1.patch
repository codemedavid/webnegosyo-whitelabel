+// How long to let CoreBluetooth advertise-scan before answering the JS caller.
+// The JS layer times a scan window out at 6s, so answering at 5s guarantees the
+// real result always beats that timeout.
+static const NSTimeInterval RNBLEScanWindowSeconds = 5.0;
+
 RCT_EXPORT_METHOD(getDeviceList:(RCTResponseSenderBlock)successCallback
                   fail:(RCTResponseSenderBlock)errorCallback) {
     @try {
         !_printerArray ? [NSException raise:@"Null pointer exception" format:@"Must call init function first"] : nil;
+
+        // Two defects fixed here, both iOS-only:
+        //
+        // 1. successCallback used to be invoked from INSIDE the per-printer
+        //    discovery block. With no printer in range the block never runs, so
+        //    JS was never called back at all and the scan hung until its
+        //    timeout — the app "kept loading" and reported no printers. We now
+        //    always answer after a fixed scan window with whatever was found.
+        //
+        // 2. An RCTResponseSenderBlock may be invoked at most once; a second
+        //    call raises "Callback was already invoked". Discovering two
+        //    printers used to do exactly that. `responded` makes it single-shot.
+        //
+        // The old mapping loop also read the outer `printer` variable instead of
+        // the enumerated `obj`, so a two-printer scan returned the same printer
+        // twice. Building from the array directly fixes that.
+        NSMutableArray *discovered = _printerArray;
+        __block BOOL responded = NO;
+
+        void (^respond)(void) = ^{
+            if (responded) { return; }
+            responded = YES;
+
+            NSMutableArray *mapped = [NSMutableArray arrayWithCapacity:[discovered count]];
+            NSMutableSet *seen = [NSMutableSet new];
+            for (Printer *found in discovered) {
+                if (!found.UUIDString || [seen containsObject:found.UUIDString]) { continue; }
+                [seen addObject:found.UUIDString];
+                [mapped addObject:@{
+                    @"device_name" : found.name ?: @"Unknown Printer",
+                    @"inner_mac_address" : found.UUIDString
+                }];
+            }
+            successCallback(@[mapped]);
+        };
+
         [[PrinterSDK defaultPrinterSDK] scanPrintersWithCompletion:^(Printer* printer){
-            [_printerArray addObject:printer];
-            NSMutableArray *mapped = [NSMutableArray arrayWithCapacity:[_printerArray count]];
-            [_printerArray enumerateObjectsUsingBlock:^(id obj, NSUInteger idx, BOOL *stop) {
-                NSDictionary *dict = @{ @"device_name" : printer.name, @"inner_mac_address" : printer.UUIDString};
-                [mapped addObject:dict];
-            }];
-            NSMutableArray *uniquearray = (NSMutableArray *)[[NSSet setWithArray:mapped] allObjects];;
-            successCallback(@[uniquearray]);
+            if (printer) { [discovered addObject:printer]; }
         }];
+
+        dispatch_after(
+            dispatch_time(DISPATCH_TIME_NOW, (int64_t)(RNBLEScanWindowSeconds * NSEC_PER_SEC)),
+            dispatch_get_main_queue(),
+            respond);
     } @catch (NSException *exception) {
         errorCallback(@[exception.reason]);
     }
