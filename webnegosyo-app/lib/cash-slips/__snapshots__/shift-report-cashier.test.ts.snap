exports[`cashier shift report at 32 columns blind and uncounted prints no money anywhere, says So far, keeps first/last receipt and void numbers 1`] = `
"          LOLY'S CAFE
          Main branch
          SHIFT REPORT
             So far
--------------------------------
Cashier            Jenica Santos
Drawer                 Cashier 1
Business day   Tue, Oct 20, 2026
Opened              10:00 AM Tue
Closed                still open
Printed     Oct 20, 2026 8:05 PM
--------------------------------
Totals stay hidden until the
drawer is counted.
--------------------------------
VOIDS
#03  11:00 AM
--------------------------------
First receipt                #01
Last receipt                 #07
Receipt count                  2
--------------------------------
Cashier signature:

______________________________

Checked by:

______________________________
--------------------------------
    Not an official receipt.
         For store use.
"
`;

