# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# AppleDouble sidecars. The iOS builder runs macOS, where tar reads a `._x`
# file as extended-attribute metadata for `x` and aborts the whole extract with
# "Failed to restore metadata: File exists" — one stray sidecar fails the build
# in PREPARE_PROJECT. Linux builders ignore them, so Android passes and only iOS
# breaks. EAS archives untracked-but-unignored files, so ignoring is the fix.
._*

# editor swap files — same tar hazard once macOS pairs them with a `._` sidecar
*.swp
*.swo
*~

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# test coverage
coverage/

# local editor/agent settings
.claude/

# generated native folders
/ios
/android
google-services.json
