{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "store": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_API_URL": "https://www.webnegosyo.com"
      }
    }
  },
  "submit": {
    "store": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
